[Desktop Entry]
Version=1.0
Type=Application
Name=Datamosh Glitch Studio
GenericName=Visual Artifact & I-Frame Glitch Synthesizer
Comment=H.264 I-Frame Drop, Bitplane Glitch, Motion Vector Engine & MCP Video Workstation
Exec=/usr/local/bin/datamosh desktop
Icon=datamosh-glitch-studio
Terminal=false
Categories=Development;Graphics;AudioVideo;Video;
StartupNotify=true
Actions=CLI;Web;

[Desktop Action CLI]
Name=Open Datamosh CLI
Exec=x-terminal-emulator -e "/usr/local/bin/datamosh --help"

[Desktop Action Web]
Name=Open Web UI (Port 8081)
Exec=/usr/local/bin/datamosh web
